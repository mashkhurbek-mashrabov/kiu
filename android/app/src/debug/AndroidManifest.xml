<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Debug-only: lets `adb shell am start/broadcast` fake an incoming lesson call
             without waiting for a real lesson start instant. Both components stay
             exported="false" in release, so this never ships. -->
        <activity
            android:name=".LessonCallActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <receiver
            android:name=".LessonCallReceiver"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
