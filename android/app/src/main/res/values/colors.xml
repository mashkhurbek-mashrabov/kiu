<?xml version="1.0" encoding="utf-8"?>
<!--
  Palette shared by the home-screen widget and the lesson-call screen.

  These mirror lib/core/theme.dart: an app-launcher widget cannot read the
  Flutter ColorScheme, so the values are duplicated here on purpose. Change
  both together or the widget drifts away from the app it belongs to.
-->
<resources>
    <!-- Brand -->
    <color name="kiu_green">#176B45</color>
    <color name="kiu_green_bright">#1DA05F</color>
    <color name="kiu_amber">#9A6B00</color>

    <!--
      Widget, light. Neutral greys mirroring lib/core/theme.dart's Instagram
      palette: the widget sits next to the app's own white settings, so a
      green-tinted surface here reads as a different product. Green survives
      only in the wordmark and in lesson state (see WidgetTheme).
    -->
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_on_surface">#0F0F0F</color>
    <color name="widget_on_surface_variant">#737373</color>
    <color name="widget_outline">#DBDBDB</color>
    <!-- Items are white on white, so the stroke is what separates them. -->
    <color name="widget_item">#FFFFFF</color>
    <color name="widget_item_other">#FAFAFA</color>
    <color name="widget_time_pill">#F1F1F1</color>
    <color name="widget_sync_idle">#F1F1F1</color>
    <color name="widget_sync_pressed">#DBDBDB</color>
    <color name="widget_amber_text">#7A5500</color>
    <color name="widget_amber_time">#8A6500</color>

    <!--
      Sync glyph. One value for both modes on purpose: it is a static vector
      and the widget follows the in-app Appearance setting, not the -night
      qualifier, so the resource system cannot pick a variant here (the same
      reason WidgetTheme resolves ints in Kotlin). Mid-grey is the one tone
      that reads on both the #F1F1F1 and #1C1C1C sync button.
    -->
    <color name="widget_sync_glyph">#8E8E8E</color>

    <!-- Widget, dark -->
    <color name="widget_surface_dark">#000000</color>
    <color name="widget_on_surface_dark">#F5F5F5</color>
    <color name="widget_on_surface_variant_dark">#A8A8A8</color>
    <color name="widget_outline_dark">#262626</color>
    <color name="widget_item_dark">#121212</color>
    <color name="widget_item_other_dark">#0A0A0A</color>
    <color name="widget_time_pill_dark">#262626</color>
    <color name="widget_sync_idle_dark">#1C1C1C</color>
    <color name="widget_sync_pressed_dark">#2A2A2A</color>
    <color name="widget_green_dark">#6FD3A0</color>
    <color name="widget_amber_dark">#E3B85F</color>

    <!-- Accent bars: scheduled vs already started. -->
    <color name="accent_scheduled">#F2B705</color>
    <color name="accent_started">#176B45</color>

    <!-- Lesson call screen -->
    <color name="call_bg_top">#0E4630</color>
    <color name="call_bg_mid">#0A2B1D</color>
    <color name="call_bg_bottom">#061410</color>
    <color name="call_brand">#BFE8D2</color>
    <color name="call_label">#7FD7AC</color>
    <color name="call_title">#FFFFFF</color>
    <color name="call_subtle">#B9DCC9</color>
    <color name="call_muted">#8FB3A2</color>
    <color name="call_avatar">#175039</color>
    <color name="call_avatar_top">#276E4E</color>
    <color name="call_avatar_stroke">#39906A</color>
    <color name="call_answer">#149652</color>
    <color name="call_answer_top">#24B96C</color>
    <color name="call_decline">#C7332A</color>
    <color name="call_decline_top">#E24A3E</color>
    <color name="call_halo_fill">#14318F63</color>
    <color name="call_halo_ring">#3339906A</color>
    <color name="call_halo_ring_faint">#1F39906A</color>
    <color name="call_countdown_bg">#1FFFFFFF</color>
    <color name="call_brand_pill">#14BFE8D2</color>
</resources>
