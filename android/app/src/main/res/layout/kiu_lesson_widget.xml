<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kiu_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KIU"
                android:textColor="#176B45"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_divider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="7dp"
                android:text="|"
                android:textColor="#A6B4AB"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Scheduled online lessons"
                android:textColor="#176B45"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_sync"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/kiu_widget_sync">

            <ImageButton
                android:id="@+id/widget_sync_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/kiu_widget_sync_button"
                android:contentDescription="@string/kiu_widget_sync"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_sync" />

            <ProgressBar
                android:id="@+id/widget_sync_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="#176B45"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#176B45"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_last_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="2dp"
        android:textColor="#68746D"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lesson_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/lesson_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No scheduled lessons"
            android:textColor="#68746D" />
    </FrameLayout>
</LinearLayout>
