<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lesson_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kiu_widget_lesson_item_other"
    android:minHeight="60dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/lesson_scheduled_accent"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="#F2B705"
        android:text=""
        android:visibility="gone" />

    <TextView
        android:id="@+id/lesson_started_accent"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="#176B45"
        android:text=""
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/lesson_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#34413A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lesson_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/kiu_widget_lesson_time"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="#68746D"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/lesson_call_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_call_off" />
</LinearLayout>
