<?xml version="1.0" encoding="utf-8"?>
<!--
  Lesson row for a later day. Same anatomy as kiu_lesson_widget_item.xml in
  neutral colours; keep the two in step.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lesson_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kiu_widget_lesson_item_other"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="6dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/lesson_scheduled_accent"
        android:layout_width="4dp"
        android:layout_height="34dp"
        android:background="@drawable/kiu_widget_accent"
        android:text=""
        android:visibility="gone" />

    <TextView
        android:id="@+id/lesson_started_accent"
        android:layout_width="4dp"
        android:layout_height="34dp"
        android:background="@drawable/kiu_widget_accent_started"
        android:text=""
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/lesson_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lesson_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/kiu_widget_lesson_time"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/lesson_call_toggle"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center_vertical"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_call_off" />
</LinearLayout>
