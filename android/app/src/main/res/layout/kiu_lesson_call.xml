<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kiu_call_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="0dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="40dp"
    android:paddingBottom="56dp">

    <!-- Brand row. The logo art is a dark-green silhouette on transparency, so it is tinted
         light here to stay legible against the dark call background. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/call_brand_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/kiu_logo"
            android:tint="#BFE8D2" />

        <TextView
            android:id="@+id/call_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:letterSpacing="0.18"
            android:text="@string/app_name"
            android:textColor="#BFE8D2"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/call_incoming_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:alpha="0.85"
        android:letterSpacing="0.14"
        android:textAllCaps="true"
        android:textColor="#7FD7AC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Halo + avatar. The avatar carries the lesson's initial so the screen reads as a
         call from the lesson itself rather than a generic alert. -->
    <FrameLayout
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_marginTop="26dp">

        <View
            android:id="@+id/call_halo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/kiu_call_halo" />

        <TextView
            android:id="@+id/call_avatar"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/kiu_call_avatar_bg"
            android:gravity="center"
            android:textColor="#EAF7F0"
            android:textSize="42sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Lesson name. -->
    <TextView
        android:id="@+id/call_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="27sp"
        android:textStyle="bold" />

    <!-- Lesson start, already converted to the user's selected time zone by Dart. -->
    <TextView
        android:id="@+id/call_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/kiu_call_time_pill"
        android:paddingHorizontal="18dp"
        android:paddingVertical="9dp"
        android:textColor="#B9DCC9"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/call_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:alpha="0.75"
        android:drawableStart="@drawable/ic_lesson_call_timer"
        android:drawablePadding="7dp"
        android:gravity="center_vertical"
        android:textColor="#8FB3A2"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/call_decline"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/kiu_call_decline_bg"
                android:contentDescription="@null"
                android:elevation="8dp"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lesson_call_decline" />

            <TextView
                android:id="@+id/call_decline_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.9"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/call_answer"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/kiu_call_answer_bg"
                android:contentDescription="@null"
                android:elevation="8dp"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lesson_call_answer" />

            <TextView
                android:id="@+id/call_answer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.9"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
