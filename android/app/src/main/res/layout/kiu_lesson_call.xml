<?xml version="1.0" encoding="utf-8"?>
<!--
  Incoming-lesson call screen.

  Reads top to bottom as: who is calling (brand), which lesson (avatar + label
  + title + time), how long you have (countdown), and what you can do
  (buttons).

  Deliberately NOT a ScrollView. A call screen must never require scrolling to
  reach Answer, so the brand row, countdown and button row are fixed height and
  the identity block in the middle takes layout_weight="1" and absorbs whatever
  space is left. values/dimens.xml holds the compact metrics and values-h700dp
  opens them up on a tall screen, so the buttons stay put either way.

  Every id here is bound by LessonCallActivity - do not rename without
  updating it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kiu_call_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="@dimen/call_top_padding"
    android:paddingBottom="@dimen/call_bottom_padding">

    <!-- Brand chip. The logo art is a dark-green silhouette on transparency,
         so it is tinted light to stay legible on the dark background. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kiu_call_brand_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp"
        android:paddingVertical="7dp">

        <ImageView
            android:id="@+id/call_brand_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/kiu_logo"
            android:tint="@color/call_brand" />

        <TextView
            android:id="@+id/call_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:letterSpacing="0.16"
            android:text="@string/app_name"
            android:textColor="@color/call_brand"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Identity block. Weighted, so it is the only part that gives ground
         when the screen is short.

         Giving ground is not automatic: a weighted LinearLayout hands its
         child the leftover height whether or not the content fits, and the
         children then overflow their box instead of shrinking - which is how
         the countdown ended up painted over a clipped start-time pill on a
         533dp-tall screen. The avatar below therefore carries
         layout_weight="1" of its own (it is decoration, so it is what should
         yield) and the text keeps its intrinsic height. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="0dp"
        android:orientation="vertical">

        <!-- The halo keeps its design size and is the first thing dropped when
             there is no room for it: LessonCallActivity hides it outright on a
             screen too short to seat the text below, rather than letting a
             half-clipped circle push the start time under the countdown. -->
        <FrameLayout
            android:id="@+id/call_avatar_block"
            android:layout_width="@dimen/call_halo_size"
            android:layout_height="@dimen/call_halo_size">

            <View
                android:id="@+id/call_halo_outer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/kiu_call_halo_outer" />

            <View
                android:id="@+id/call_halo"
                android:layout_width="@dimen/call_halo_inner"
                android:layout_height="@dimen/call_halo_inner"
                android:layout_gravity="center"
                android:background="@drawable/kiu_call_halo" />

            <!-- The avatar carries the lesson's initial so the screen reads as
                 a call from the lesson itself, not a generic alert. -->
            <TextView
                android:id="@+id/call_avatar"
                android:layout_width="@dimen/call_avatar_size"
                android:layout_height="@dimen/call_avatar_size"
                android:layout_gravity="center"
                android:background="@drawable/kiu_call_avatar_bg"
                android:elevation="6dp"
                android:gravity="center"
                android:textColor="@color/call_title"
                android:textSize="@dimen/call_avatar_text"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/call_incoming_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_label_margin"
            android:alpha="0.9"
            android:letterSpacing="0.16"
            android:textAllCaps="true"
            android:textColor="@color/call_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Lesson name. Ellipsizes rather than pushing the buttons down. -->
        <TextView
            android:id="@+id/call_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxLines="@integer/call_title_max_lines"
            android:textColor="@color/call_title"
            android:textSize="@dimen/call_title_text"
            android:textStyle="bold" />

        <!-- Lesson start, already converted to the user's zone by Dart. -->
        <TextView
            android:id="@+id/call_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/kiu_call_time_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="9dp"
            android:textColor="@color/call_subtle"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Seconds left before the call gives up. A filled chip rather than a
         bare number: on its own the digit looked like part of the time. -->
    <TextView
        android:id="@+id/call_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/call_countdown_margin"
        android:background="@drawable/kiu_call_countdown_pill"
        android:drawableStart="@drawable/ic_lesson_call_timer"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/call_subtle"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/call_decline"
                android:layout_width="@dimen/call_button_size"
                android:layout_height="@dimen/call_button_size"
                android:background="@drawable/kiu_call_decline_bg"
                android:contentDescription="@null"
                android:elevation="6dp"
                android:padding="@dimen/call_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lesson_call_decline" />

            <TextView
                android:id="@+id/call_decline_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:alpha="0.85"
                android:textColor="@color/call_title"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical">

            <!-- Same size as decline; answer is distinguished by its green
                 fill and bold label, not by being bigger.

                 The idle nudge translates this button upward. translationY does
                 not affect layout, so the label below stays put - but the row
                 must not clip, hence clipChildren="false" on both parents. -->
            <ImageButton
                android:id="@+id/call_answer"
                android:layout_width="@dimen/call_button_size"
                android:layout_height="@dimen/call_button_size"
                android:background="@drawable/kiu_call_answer_bg"
                android:contentDescription="@null"
                android:elevation="6dp"
                android:padding="@dimen/call_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lesson_call_answer" />

            <TextView
                android:id="@+id/call_answer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/call_title"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
