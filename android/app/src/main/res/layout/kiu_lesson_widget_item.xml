<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lesson_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kiu_widget_lesson_item"
    android:minHeight="60dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/lesson_scheduled_accent"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="#F2B705" />

    <View
        android:id="@+id/lesson_started_accent"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="#176B45"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/lesson_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#A77800"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lesson_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8A6500"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
