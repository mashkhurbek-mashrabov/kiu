<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only to the on-device loopback server that serves downloaded
     lesson videos to the WebView. Every other host stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
