<?xml version="1.0" encoding="utf-8"?>
<!--
  Today's lesson. The fill used to be a green tint, which is what separated it
  from the widget surface; now that both are white the stroke is the only
  boundary, so it is not optional.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_item" />
    <stroke android:width="1dp" android:color="@color/widget_outline" />
    <corners android:radius="14dp" />
</shape>
